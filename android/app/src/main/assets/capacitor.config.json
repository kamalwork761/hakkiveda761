{
	"appId": "com.hakkiveda.app",
	"appName": "HAKKIVEDA",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"hakkiveda.com",
			"*.hakkiveda.com",
			"api.razorpay.com",
			"*.razorpay.com",
			"checkout.razorpay.com"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#0E3B2E",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0E3B2E"
		}
	}
}
