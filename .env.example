# Server Configuration
PORT=3000
NODE_ENV=production

# App Domain / URL
APP_URL=https://yourdomain.com

# Gemini AI API Key (Required for AI Hair Quiz & Botanical Chat Advisor)
GEMINI_API_KEY=your_gemini_api_key_here

# Persistent Uploads Directory (Local or Mounted Storage)
UPLOAD_DIR=./uploads

# Optional: Storage Provider ("local" or "s3")
STORAGE_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

